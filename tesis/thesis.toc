\contentsline {chapter}{\numberline {7}Conclusions \& Future Work}{107}{chapter.7}%
\contentsline {section}{\numberline {7.1}Conclusions}{107}{section.7.1}%
\contentsline {paragraph}{The adaptation costs no more than the flights.}{107}{paragraph*.68}%
\contentsline {paragraph}{Co-design improves on morphology-only evolution on both objectives.}{107}{paragraph*.69}%
\contentsline {paragraph}{The body search takes a different direction when the controller adapts.}{108}{paragraph*.70}%
\contentsline {paragraph}{The controller adapts to the morphology.}{108}{paragraph*.71}%
\contentsline {paragraph}{The rules recover part of what the generalist lacks on a given body.}{108}{paragraph*.72}%
\contentsline {paragraph}{On a specialist, the rules make the flight dynamics plastic.}{109}{paragraph*.73}%
\contentsline {paragraph}{The price is the generality of the controller.}{109}{paragraph*.74}%
\contentsline {paragraph}{Limits of the study.}{109}{paragraph*.75}%
