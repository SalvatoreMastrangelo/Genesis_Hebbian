\contentsline {chapter}{\numberline {7}Conclusions \& Future Work}{97}{chapter.7}%
\contentsline {section}{\numberline {7.1}Conclusions}{97}{section.7.1}%
\contentsline {paragraph}{The adaptation costs no more than the flights.}{97}{paragraph*.67}%
\contentsline {paragraph}{Co-design improves on morphology-only evolution on both objectives.}{97}{paragraph*.68}%
\contentsline {paragraph}{The body search takes a different direction when the controller adapts.}{98}{paragraph*.69}%
\contentsline {paragraph}{The controller adapts to the morphology.}{98}{paragraph*.70}%
\contentsline {paragraph}{The rules recover part of what the generalist lacks on a given body.}{98}{paragraph*.71}%
\contentsline {paragraph}{On a specialist, the rules make the flight dynamics plastic.}{99}{paragraph*.72}%
\contentsline {paragraph}{The price is the generality of the controller.}{99}{paragraph*.73}%
\contentsline {paragraph}{Limits of the study.}{99}{paragraph*.74}%
