\contentsline {section}{\numberline {7.1}Conclusions}{99}{section.7.1}%
\contentsline {paragraph}{The adaptation costs no more than the flights.}{99}{paragraph*.70}%
\contentsline {paragraph}{Co-design improves on morphology-only evolution on both objectives.}{99}{paragraph*.71}%
\contentsline {paragraph}{The body search takes a different direction when the controller adapts.}{100}{paragraph*.72}%
\contentsline {paragraph}{The controller adapts to the morphology.}{100}{paragraph*.73}%
\contentsline {paragraph}{The rules recover part of what the generalist lacks on a given body.}{100}{paragraph*.74}%
\contentsline {paragraph}{On a specialist, the rules make the flight dynamics plastic.}{101}{paragraph*.75}%
\contentsline {paragraph}{The price is the generality of the controller.}{101}{paragraph*.76}%
\contentsline {paragraph}{Limits of the study.}{101}{paragraph*.77}%
